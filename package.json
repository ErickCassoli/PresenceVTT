{
  "name": "presencevtt",
  "version": "1.1.0",
  "description": "presenceVTT — apresentador de mapas com fog of war para RPG de mesa presencial",
  "main": "main.js",
  "author": "Erick Cassoli",
  "contributors": [
    "Hinnful (Evermist, base project)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ErickCassoli/PresenceVTT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErickCassoli/PresenceVTT.git"
  },
  "bugs": {
    "url": "https://github.com/ErickCassoli/PresenceVTT/issues"
  },
  "scripts": {
    "start": "electron .",
    "lint": "npx --yes eslint@9 .",
    "test": "node --test",
    "build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "build:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "build:linux": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.presencevtt.app",
    "productName": "presenceVTT",
    "icon": "build/icon.png",
    "artifactName": "${productName}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "ErickCassoli",
        "repo": "PresenceVTT"
      }
    ],
    "files": [
      "index.html",
      "splash.html",
      "i18n.js",
      "lib/pixi.min.js",
      "lib/howler.min.js",
      "renderer.js",
      "state.js",
      "scenes.js",
      "viewport.js",
      "ruler.js",
      "systems.js",
      "conditions.js",
      "tokens.js",
      "aoe.js",
      "draw.js",
      "rules.js",
      "system-editor.js",
      "soundboard.js",
      "blackout.js",
      "backup.js",
      "shortcuts.js",
      "fog.js",
      "tools.js",
      "sceneStore.js",
      "main.js",
      "preload.js",
      "fonts/cinzel-600.woff2",
      "NOTICE"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "electron-updater": "^6.3.9",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "pixi.js": "^7.4.3"
  }
}
